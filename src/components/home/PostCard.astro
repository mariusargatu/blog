---
interface Props {
  href: string
  title: string
  description: string
  kicker: string
  date: string
  minutesRead?: number
  accent?: 'primary' | 'secondary' | 'tertiary'
}

const {
  href,
  title,
  description,
  kicker,
  date,
  minutesRead,
  accent = 'primary',
} = Astro.props

const accentText = {
  primary: 'text-primary',
  secondary: 'text-secondary',
  tertiary: 'text-tertiary',
}[accent]
---

<article
  data-reveal
  class="group relative bg-surface border border-border-dark p-6 flex flex-col justify-between hover:bg-surface-hover transition-all duration-300 min-h-[220px]"
>
  <div class="flex justify-between items-start gap-3 mb-8">
    <span class:list={['font-mono text-mono-xs', accentText]}>{kicker}</span>
    {
      minutesRead && (
        <span class="font-mono text-mono-xs text-text-muted shrink-0">
          {minutesRead} MIN
        </span>
      )
    }
  </div>
  <div class="flex-1">
    <h3
      class="text-headline-md text-text-primary mb-3 group-hover:text-primary transition-colors"
    >
      {title}
    </h3>
    <p class="font-mono text-mono-xs text-text-muted leading-relaxed line-clamp-3">
      {description}
    </p>
  </div>
  <div class="mt-6 font-mono text-mono-xs text-text-muted">{date}</div>
  <a href={href} aria-label={`Read: ${title}`} class="absolute inset-0"></a>
</article>
