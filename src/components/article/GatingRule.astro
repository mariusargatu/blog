---
import DiagramLabel from './DiagramLabel.astro'
// The single most important rule in the statistics article, made visual, with the committed
// numbers from the Atlas repo (`task benchmark`, the `release_gate` block of benchmark_study.json).
// The candidate v_b must clear a release bar of 0.80. Its point is 0.81 with a Wilson 95%
// interval whose floor is 0.722. Toggle the gating rule: gate on the point and it ships on
// optimism (0.81 >= 0.80, green, wrong); gate on the lower bound and it fails closed
// (0.722 < 0.80, "we cannot tell yet" blocks the release). Numbers are the committed
// artifact's, not illustrative. Keep in sync with
// testing/harness/evals/benchmark/artifacts/benchmark_study.json if the fixture or seed changes.
const THRESHOLD = 0.8
const POINT = 0.81
const LO = 0.722
const HI = 0.875
const D0 = 0.65
const SPAN = 1.0 - D0
const pos = (x: number) => ((x - D0) / SPAN) * 100
const pct = (x: number) => `${(x * 100).toFixed(0)}%`
---

{/* Statically rendered in floor mode — the honest gating rule and the committed verdict — so a
    no-JS render or an extracted snapshot never quotes "0.81 clears the bar, ship" out of context.
    The script flips the interactive experience back to point mode on init so the toggle
    pedagogy is unchanged. */}
<figure class="not-prose my-10 border border-border-dark bg-surface rounded-lg p-5" data-gr data-pass="false" data-inview>
  <div class="mb-4 flex items-center gap-2">
    <DiagramLabel label="Gate on the floor, never the point" />
    <div class="h-px flex-1 bg-border-dark"></div>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-6" role="group" aria-label="Which number the release gates on">
    <span class="font-mono text-mono-xs text-text-muted mr-1" aria-hidden="true">Gate on:</span>
    <button type="button" class="gr-toggle inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark text-text-muted transition-colors" data-gr-mode="point" aria-pressed="false">
      the point
    </button>
    <button type="button" class="gr-toggle on inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark transition-colors" data-gr-mode="floor" aria-pressed="true">
      the lower bound
    </button>
  </div>

  <div class="mb-3" aria-hidden="true">
    <div class="flex flex-wrap items-baseline gap-x-3 mb-3">
      <span class="font-mono text-3xl text-text-primary">{POINT.toFixed(2)}</span>
      <span class="font-mono text-mono-xs text-text-muted">Wilson 95% CI [{LO.toFixed(3)}, {HI.toFixed(3)}]</span>
      <span class="font-mono text-mono-xs uppercase tracking-wide sm:ml-auto" data-gr-verdict>hold</span>
    </div>
    <div class="gr-track relative h-3 w-full">
      <div class="gr-bar absolute inset-y-0" style={`left:${pos(LO)}%;width:${pos(HI) - pos(LO)}%`}></div>
      <div class="gr-dot absolute top-1/2 -translate-x-1/2 -translate-y-1/2" style={`left:${pos(POINT)}%`}></div>
      <div class="gr-read absolute -top-1 -bottom-1 w-0.5" data-gr-read style={`left:${pos(LO)}%`}></div>
      <div class="gr-thresh absolute -top-2 -bottom-2 w-0.5" style={`left:${pos(THRESHOLD)}%`}></div>
    </div>
    <div class="relative mt-1.5 font-mono text-mono-xs text-text-muted">
      <span>{pct(D0)}</span>
      <span class="absolute -translate-x-1/2 text-text-primary whitespace-nowrap" style={`left:${pos(THRESHOLD)}%`}>0.80 bar</span>
      <span class="float-right">100%</span>
    </div>
  </div>

  <figcaption class="m-0 mt-5 border-t border-border-dark pt-4 font-mono text-mono-xs text-text-muted" data-gr-caption aria-live="polite">
    Gate on the lower bound: the floor is 0.722, below the 0.80 bar, so the release holds. "We cannot tell yet" fails closed, which is the only safe direction for a number that might be noise. This is the committed verdict, not an illustration.
  </figcaption>
</figure>

<style is:global>
  [data-gr] .gr-toggle.on {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }
  [data-gr] .gr-track {
    background: var(--color-surface-container-high);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-full);
  }
  [data-gr] .gr-bar {
    background: color-mix(in srgb, var(--color-text-muted) 35%, transparent);
    border-radius: var(--radius-full);
  }
  [data-gr] .gr-dot {
    width: 11px;
    height: 11px;
    border-radius: var(--radius-full);
    background: var(--color-text-primary);
    box-shadow: 0 0 0 3px var(--color-surface);
  }
  [data-gr] .gr-thresh {
    background: var(--color-text-primary);
  }
  /* the reading marker (which number the gate actually checks) slides from point to floor */
  [data-gr] .gr-read {
    background: var(--color-error);
    transition: left 0.45s var(--ease-out-quint);
  }
  [data-gr][data-pass='true'] .gr-read {
    background: var(--color-primary);
  }
  [data-gr] [data-gr-verdict] {
    color: var(--color-primary);
  }
  [data-gr][data-pass='false'] [data-gr-verdict] {
    color: var(--color-error);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-gr] .gr-read {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-gr]')
  if (root) {
    const THRESHOLD = 0.8
    const POINT = 0.81
    const LO = 0.722
    const D0 = 0.65
    const SPAN = 1.0 - D0
    const pos = (x: number) => ((x - D0) / SPAN) * 100

    const toggles = [...root.querySelectorAll<HTMLButtonElement>('[data-gr-mode]')]
    const readEl = root.querySelector<HTMLElement>('[data-gr-read]')!
    const verdictEl = root.querySelector<HTMLElement>('[data-gr-verdict]')!
    const captionEl = root.querySelector<HTMLElement>('[data-gr-caption]')!

    const captions: Record<string, string> = {
      point:
        'Gate on the point: 0.81 clears the 0.80 bar, so it ships. That is shipping on the best guess, with an honest floor sitting far below the line.',
      floor:
        'Gate on the lower bound: the floor is 0.722, below the 0.80 bar, so the release holds. "We cannot tell yet" fails closed, which is the only safe direction for a number that might be noise. This is the committed verdict, not an illustration.',
    }

    const render = (mode: string) => {
      const checked = mode === 'point' ? POINT : LO
      const pass = checked >= THRESHOLD
      readEl.style.left = `${pos(checked)}%`
      root.dataset.pass = String(pass)
      verdictEl.textContent = pass ? 'ship' : 'hold'
      captionEl.textContent = captions[mode]
      toggles.forEach((t) => {
        const on = t.dataset.grMode === mode
        t.classList.toggle('on', on)
        t.setAttribute('aria-pressed', String(on))
      })
    }

    toggles.forEach((t) => t.addEventListener('click', () => render(t.dataset.grMode!)))
    render('point')
  }
</script>
