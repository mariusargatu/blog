---
import DiagramLabel from './DiagramLabel.astro'
// The single most important rule in the statistics article, made visual, on Atlas's own retrieval
// gate. Reproduce every number here with:
//   uv run python -m evals.measure_retrieval
// which ends on exactly this block:
//   gate on hit_rate@3, threshold 0.3, point 0.3468
//     variance_budget 0.20  FAIL       lower bound 0.269 is below the 0.300 bar
//     variance_budget 0.10  QUARANTINE interval width 0.165 exceeds the 0.100 variance budget
// hit_rate@3 is 0.3468 over n=124, Wilson 95% [0.2687, 0.4340].
//
// This is the real thing, on real data, and nothing about it was arranged: the point clears the
// 0.300 bar and the floor does not, so the two gating rules genuinely disagree about whether this
// ships. Toggle between them and the same measurement reads as green or as fails closed.
//
// An earlier draft of this figure ran on a 100 item benchmark scoring 0.81 against a 0.80 bar, cited
// to `task benchmark` and a benchmark_study.json artifact. That task, that artifact and that dataset
// do not exist in the rebuilt tree, so the figure now runs on a lane a reader can actually execute.
const THRESHOLD = 0.3
const POINT = 0.3468
const LO = 0.2687
const HI = 0.434
const N = 124
const D0 = 0.2
const TOP = 0.5
const SPAN = TOP - D0
const pos = (x: number) => ((x - D0) / SPAN) * 100
const pct = (x: number) => `${(x * 100).toFixed(0)}%`
---

{/* Statically rendered in floor mode, the honest gating rule and the real verdict, so a no-JS
    render or an extracted snapshot never quotes "0.3468 clears the bar, ship" out of context.
    The script flips the interactive experience back to point mode on init so the toggle
    pedagogy is unchanged. */}
<figure class="not-prose my-10 border border-border-dark bg-surface rounded-lg p-5" data-gr data-pass="false" data-inview>
  <div class="mb-4 flex items-center gap-2">
    <DiagramLabel label="Gate on the floor, never the point" />
    <div class="h-px flex-1 bg-border-dark"></div>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-6" role="group" aria-label="Which number the release gates on">
    <span class="font-mono text-mono-xs text-text-muted mr-1" aria-hidden="true">Gate on:</span>
    <button type="button" class="gr-toggle inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark text-text-muted transition-colors" data-gr-mode="point" aria-pressed="false">
      the point
    </button>
    <button type="button" class="gr-toggle on inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark transition-colors" data-gr-mode="floor" aria-pressed="true">
      the lower bound
    </button>
  </div>

  <div class="mb-3" aria-hidden="true">
    <div class="flex flex-wrap items-baseline gap-x-3 mb-3">
      <span class="font-mono text-3xl text-text-primary">{POINT.toFixed(4)}</span>
      <span class="font-mono text-mono-xs text-text-muted">hit_rate@3 · n={N} · Wilson 95% CI [{LO.toFixed(4)}, {HI.toFixed(4)}]</span>
      <span class="font-mono text-mono-xs uppercase tracking-wide sm:ml-auto" data-gr-verdict>hold</span>
    </div>
    <div class="gr-track relative h-3 w-full">
      <div class="gr-bar absolute inset-y-0" style={`left:${pos(LO)}%;width:${pos(HI) - pos(LO)}%`}></div>
      <div class="gr-dot absolute top-1/2 -translate-x-1/2 -translate-y-1/2" style={`left:${pos(POINT)}%`}></div>
      <div class="gr-read absolute -top-1 -bottom-1 w-0.5" data-gr-read style={`left:${pos(LO)}%`}></div>
      <div class="gr-thresh absolute -top-2 -bottom-2 w-0.5" style={`left:${pos(THRESHOLD)}%`}></div>
    </div>
    <div class="relative mt-1.5 font-mono text-mono-xs text-text-muted">
      <span>{pct(D0)}</span>
      <span class="absolute -translate-x-1/2 text-text-primary whitespace-nowrap" style={`left:${pos(THRESHOLD)}%`}>0.300 bar</span>
      <span class="float-right">{pct(TOP)}</span>
    </div>
  </div>

  <figcaption class="m-0 mt-5 border-t border-border-dark pt-4 font-mono text-mono-xs text-text-muted" data-gr-caption aria-live="polite">
    Gate on the lower bound: the floor is 0.2687, below the 0.300 bar, so the gate fails closed. "We cannot tell yet" is the only safe reading of a number that might be noise. This is what <code>uv run python -m evals.measure_retrieval</code> prints today, on real data, with nothing arranged. Tighten the variance budget from 0.20 to 0.10 and the same measurement stops being a FAIL and becomes a QUARANTINE, because an interval 0.165 wide is too wide to decide anything with.
  </figcaption>
</figure>

<style is:global>
  [data-gr] .gr-toggle.on {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }
  [data-gr] .gr-track {
    background: var(--color-surface-container-high);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-full);
  }
  [data-gr] .gr-bar {
    background: color-mix(in srgb, var(--color-text-muted) 35%, transparent);
    border-radius: var(--radius-full);
  }
  [data-gr] .gr-dot {
    width: 11px;
    height: 11px;
    border-radius: var(--radius-full);
    background: var(--color-text-primary);
    box-shadow: 0 0 0 3px var(--color-surface);
  }
  [data-gr] .gr-thresh {
    background: var(--color-text-primary);
  }
  /* the reading marker (which number the gate actually checks) slides from point to floor */
  [data-gr] .gr-read {
    background: var(--color-error);
    transition: left 0.45s var(--ease-out-quint);
  }
  [data-gr][data-pass='true'] .gr-read {
    background: var(--color-primary);
  }
  [data-gr] [data-gr-verdict] {
    color: var(--color-primary);
  }
  [data-gr][data-pass='false'] [data-gr-verdict] {
    color: var(--color-error);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-gr] .gr-read {
      transition: none;
    }
  }
</style>
