---
import DiagramFigure from './DiagramFigure.astro'

// The four load-bearing parts of a golden case, shown on a real Atlas case lifted verbatim from
// the committed seed set: corpus/seed_cases.jsonl, case_id seed-mt-daniel-over-cap-upgrade.
// Read the case itself with:
//   uv run python -c "import json; \
//     print([json.loads(l) for l in open('corpus/seed_cases.jsonl') \
//            if json.loads(l)['case_id'] == 'seed-mt-daniel-over-cap-upgrade'][0])"
//
// Field names below are the real ones. Two honesty notes. First, the risk row shows what this case
// actually carries, which is three null class labels: the schema has the slots, and an authored
// happy path case fills none of them. Second, the oracle row is an end_state assertion written as a
// PATH with an expected value, so it re-reads the account after the run rather than trusting a
// number typed into the case months ago.

const parts = [
  {
    role: 'Input + session',
    why: 'identity rides on the session, never the chat, and that is half the test',
    body: '“Am I over my data cap this month?”  ·  customer_id = cust_legacy_term',
  },
  {
    role: 'Expected behaviour',
    why: 'written as the thing you check, not a vibe',
    body: 'checkpoint: expected_intent = troubleshooting, expected_tool_calls = [account.get_usage]',
  },
  {
    role: 'Class labels',
    why: 'the slots that let you weight and slice by consequence later',
    body: 'adversarial_class: null · failure_class: null · refusal_class: null · origin: authored',
  },
  {
    role: 'Oracle reference',
    why: 'a path re-read after the run, not a number typed in March',
    body: 'end_state.account_assertions: usage.data_cap_gb equals null, bill.amount equals 29.99',
  },
]

const ariaLabel =
  'One golden case broken into its four load-bearing parts, taken from the committed seed set. Input plus session: the question “Am I over my data cap this month?” with the session identity customer_id equals cust_legacy_term. Expected behaviour: a checkpoint expecting the troubleshooting intent and a call to account.get_usage. Class labels: the adversarial, failure and refusal class slots are all null on this authored case. Oracle reference: end state account assertions written as paths, that usage dot data_cap_gb equals null and bill dot amount equals 29.99, re-read after the run rather than frozen into the case.'
---

<DiagramFigure label="Anatomy of a case · seed-mt-daniel-over-cap-upgrade" ariaLabel={ariaLabel} data-ca>
  <div class="flex flex-col gap-2">
    {
      parts.map((p, i) => (
        <div class="grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-x-4 gap-y-1 rounded border border-border-dark bg-surface-container-low px-4 py-3">
          <div class="flex items-baseline gap-2">
            <span class="font-mono text-mono-xs text-primary">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-mono text-mono-xs uppercase tracking-wider text-text-primary">{p.role}</span>
          </div>
          <div>
            <p class="m-0 font-mono text-mono-xs text-text-primary leading-relaxed break-words">{p.body}</p>
            <p class="m-0 mt-1 font-mono text-mono-xs text-text-muted leading-relaxed">{p.why}</p>
          </div>
        </div>
      ))
    }
  </div>

  <Fragment slot="note">
    Lifted from the seed set, <code>datasets/seed.py</code>. Same sentence under
    <code>cust_current</code> is a different case with the opposite answer. The
    session decides, not the words.
  </Fragment>
</DiagramFigure>
