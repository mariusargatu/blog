---
import DiagramLabel from './DiagramLabel.astro'
// The two axes from the article, made interactive: what each metric compares against, and who
// judges it (a deterministic rule or a model). Filter to a lane to collapse the table to just that
// lane: almost every high-consequence check is a rule that gates hard and fails closed; only the
// genuinely subjective metrics go to the calibrated judge, tracked, never a hard gate. The green
// accent marks the gating/strong state (`gates`), consistent with its meaning across the article's
// figures; the rule/judge lanes are distinguished by label and the gate column, not by recolouring
// the accent. The `code` column names the grader that implements each row in the Atlas repo.
const rows = [
  { surface: 'Document answer', metric: 'faithfulness', vs: 'retrieved doc', lane: 'judge', gate: 'tracked', code: '' },
  { surface: 'Document answer', metric: 'correctness vs truth', vs: 'oracle', lane: 'rule', gate: 'gates', code: 'answer-true-vs-account' },
  { surface: 'Document answer', metric: 'answer relevancy', vs: 'none', lane: 'judge', gate: 'tracked', code: '' },
  { surface: 'Account read', metric: 'factual correctness', vs: 'oracle', lane: 'rule', gate: 'gates', code: 'read-accuracy' },
  { surface: 'Account read', metric: 'scope (this customer)', vs: 'session id', lane: 'rule', gate: 'gates', code: 'scoped-to-session' },
  { surface: 'Account read', metric: 'freshness', vs: 'oracle', lane: 'rule', gate: 'gates', code: '' },
  { surface: 'Action', metric: 'task success', vs: 'recorded call', lane: 'rule', gate: 'gates', code: 'write-applied-after-confirm' },
  { surface: 'Action', metric: 'safety / authz / confirm', vs: 'policy', lane: 'rule', gate: 'gates', code: 'no-write-applied' },
  { surface: 'Any turn', metric: 'refuse / hand off', vs: 'policy', lane: 'rule', gate: 'gates', code: '' },
  { surface: 'Subjective', metric: 'helpfulness / tone', vs: 'none', lane: 'judge', gate: 'tracked', code: 'llm-judge' },
]
const ruleCount = rows.filter((r) => r.lane === 'rule').length
const filters = [
  { key: 'all', label: 'All' },
  { key: 'rule', label: `Rules · ${ruleCount}` },
  { key: 'judge', label: `Judge · ${rows.length - ruleCount}` },
]
---

<figure class="not-prose my-10 border border-border-dark bg-surface rounded-lg p-5" data-mr data-inview>
  <div class="mb-4 flex items-center gap-2">
    <DiagramLabel label="Routing the metric: rule or judge, gate or track" />
    <div class="h-px flex-1 bg-border-dark"></div>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-4" role="group" aria-label="Filter by lane">
    <span class="font-mono text-mono-xs text-text-muted mr-1" aria-hidden="true">Lane:</span>
    {
      filters.map((f) => (
        <button type="button" class:list={['mr-lane inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark transition-colors', f.key === 'all' ? 'on' : 'text-text-muted']} data-mr-lane={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>
          {f.label}
        </button>
      ))
    }
  </div>

  <div class="overflow-x-auto">
    <table class="mr-table w-full border-collapse" style="min-width:32rem">
      <thead>
        <tr class="border-b border-border-dark text-left font-mono text-mono-xs text-text-muted">
          <th scope="col" class="font-normal py-2 pr-3">surface</th>
          <th scope="col" class="font-normal py-2 pr-3">metric</th>
          <th scope="col" class="font-normal py-2 pr-3">compares against</th>
          <th scope="col" class="font-normal py-2 pr-3">who judges</th>
          <th scope="col" class="font-normal py-2">gates?</th>
        </tr>
      </thead>
      <tbody data-mr-rows>
        {
          rows.map((r) => (
            <tr class="mr-row border-b border-border-dark/40" data-lane={r.lane}>
              <td class="font-mono text-mono-xs text-text-muted py-2 pr-3 align-top">{r.surface}</td>
              <td class="text-sm text-text-primary py-2 pr-3 align-top">
                {r.metric}
                {r.code && <code class="mr-code ml-1 inline-block font-mono text-mono-xs px-1 text-text-muted">{r.code}</code>}
              </td>
              <td class="font-mono text-mono-xs text-text-muted py-2 pr-3 align-top">{r.vs}</td>
              <td class="py-2 pr-3 align-top">
                <span class="mr-badge font-mono text-mono-xs px-2 py-0.5">{r.lane === 'rule' ? 'rule' : 'model'}</span>
              </td>
              <td class="py-2 align-top">
                <span class:list={['mr-gate font-mono text-mono-xs', r.gate === 'gates' ? 'is-gate' : 'is-track']}>
                  {r.gate === 'gates' ? 'gates ✓' : 'tracked'}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <figcaption class="m-0 mt-4 font-mono text-mono-xs text-text-muted" data-mr-caption aria-live="polite">
    Two axes decide every row: what it compares against, and who judges it. Push the costly, checkable
    checks to <span class="text-primary">rules that gate hard</span>; reserve the model judge for what no rule can reach.
  </figcaption>
</figure>

<style is:global>
  /* selection is neutral ink; the green accent is reserved for the gating/strong state (`gates ✓`). */
  [data-mr] .mr-lane.on {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }
  [data-mr] .mr-badge {
    border: 1px solid var(--color-border-dark);
    color: var(--color-text-muted);
  }
  [data-mr] .mr-gate.is-gate {
    color: var(--color-primary);
    font-weight: 600;
  }
  [data-mr] .mr-gate.is-track {
    color: var(--color-text-muted);
  }
  [data-mr] .mr-code {
    border: 1px solid var(--color-border-dark);
  }
  [data-mr] .mr-row.is-hidden {
    display: none;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-mr]')
  if (root) {
    const lanes = [...root.querySelectorAll<HTMLButtonElement>('[data-mr-lane]')]
    const rows = [...root.querySelectorAll<HTMLElement>('.mr-row')]
    const caption = root.querySelector<HTMLElement>('[data-mr-caption]')!
    const total = rows.length

    const captions: Record<string, (n: number) => string> = {
      all: () =>
        'Two axes decide every row: what it compares against, and who judges it. Push the costly, checkable checks to <span class="text-primary">rules that gate hard</span>; reserve the model judge for what no rule can reach.',
      rule: (n) =>
        `Showing ${n} of ${total}. The <span class="text-primary">rule</span> lane: scope, arguments, authorization, confirmation, correctness against the oracle. Deterministic, auditable, the same verdict forever, and they <span class="text-primary">gate hard, fail closed</span>.`,
      judge: (n) =>
        `Showing ${n} of ${total}. The judge lane: faithfulness, relevancy, helpfulness, tone. No schema fits them, so a calibrated model scores them, tracked with intervals, never a hard merge gate.`,
    }

    const render = (active: string) => {
      let shown = 0
      rows.forEach((r) => {
        const hide = active !== 'all' && r.dataset.lane !== active
        r.classList.toggle('is-hidden', hide)
        if (!hide) shown++
      })
      lanes.forEach((l) => {
        const on = l.dataset.mrLane === active
        l.classList.toggle('on', on)
        l.classList.toggle('text-text-muted', !on)
        l.setAttribute('aria-pressed', String(on))
      })
      caption.innerHTML = captions[active](shown)
    }

    lanes.forEach((l) => l.addEventListener('click', () => render(l.dataset.mrLane!)))
    render('all')
  }
</script>
