---
import DiagramLabel from './DiagramLabel.astro'

// An honest note about what the trace can and cannot show. Atlas is fail closed:
// a bad write is caught by the guard before the tool runs, and a blocked tool
// leaves no executed call record. So driving a bad write through the real graph
// returns a sound trajectory: nothing bad executed, the guard held. That is the
// runtime working, not a gap. But it means the negative direction, a trajectory
// that grades unsound because a bad action landed, cannot be produced by the
// real runtime at all, only by a hand built trajectory that skips the guard. So
// you test both. A test that can only ever go green is not a test.

const runs = {
  real: {
    trace: [
      { step: 'select tool', ok: true },
      { step: 'guard: foreign account id', ok: true, note: 'blocked before execute' },
      { step: 'no action recorded', ok: true },
    ],
    sound: true,
  },
  synthetic: {
    trace: [
      { step: 'hand built trace, guard skipped', ok: false },
      { step: 'execute: change on account #other', ok: false, note: 'a bad action landed' },
      { step: 'grader: foreign id detected', ok: true, note: 'assertion fires' },
    ],
    sound: false,
  },
}
---

{/* Statically rendered on the real graph, the true runtime behaviour, with a
    caption that names the catch: a suite that can only go green is not a test,
    which is why the synthetic case exists. The script inits to the same view;
    the toggle reveals the synthetic trajectory that proves the grader has teeth. */}
<figure class="not-prose my-10 border border-border-dark bg-surface rounded-lg p-5" data-og data-sound="true" data-inview>
  <div class="mb-4 flex items-center gap-2">
    <DiagramLabel label="A test that can only go green is not a test" />
    <div class="h-px flex-1 bg-border-dark"></div>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-5" role="group" aria-label="How the bad write is driven">
    <span class="font-mono text-mono-xs text-text-muted mr-1" aria-hidden="true">Drive a bad write via:</span>
    <button type="button" class="og-toggle on inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark transition-colors" data-og-mode="real" aria-pressed="true">
      the real graph
    </button>
    <button type="button" class="og-toggle inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark text-text-muted transition-colors" data-og-mode="synthetic" aria-pressed="false">
      a synthetic trajectory
    </button>
  </div>

  <ol class="m-0 list-none space-y-1.5 p-0" data-og-trace aria-hidden="true">
    {
      runs.real.trace.map((t) => (
        <li class:list={['og-step flex items-center gap-3 rounded border px-3 py-2', t.ok ? 'ok' : 'bad']}>
          <span class="og-mark font-mono text-mono-xs shrink-0" aria-hidden="true">{t.ok ? '✓' : '✗'}</span>
          <span class="flex-1 text-sm text-text-primary">{t.step}</span>
          {t.note && <span class="og-note font-mono text-mono-xs text-text-muted shrink-0">{t.note}</span>}
        </li>
      ))
    }
  </ol>

  <div class="mt-4 flex items-center gap-2">
    <span class="og-verdict font-mono text-mono-xs uppercase tracking-wider px-2 py-1 border" data-og-verdict>trajectory sound</span>
  </div>

  <figcaption class="m-0 mt-4 border-t border-border-dark pt-4 font-mono text-mono-xs text-text-muted" data-og-caption aria-live="polite">
    Drive a bad write through the real graph and the trajectory comes back sound: the guard blocked it before execute, so nothing bad ran and the trace shows a block and no action. That is the runtime working. But a suite that can only ever go green is not a test, which is why you also build the synthetic case.
  </figcaption>
</figure>

<style is:global>
  [data-og] .og-toggle.on {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }
  [data-og] .og-step.ok {
    border-color: color-mix(in srgb, var(--color-primary) 35%, transparent);
    background: color-mix(in srgb, var(--color-primary) 6%, transparent);
  }
  [data-og] .og-step.ok .og-mark {
    color: var(--color-primary);
  }
  [data-og] .og-step.bad {
    border-color: color-mix(in srgb, var(--color-error) 40%, transparent);
    background: color-mix(in srgb, var(--color-error) 7%, transparent);
  }
  [data-og] .og-step.bad .og-mark {
    color: var(--color-error);
  }
  [data-og] .og-verdict {
    border-color: var(--color-border-dark);
    color: var(--color-text-muted);
  }
  [data-og][data-sound='true'] .og-verdict {
    border-color: color-mix(in srgb, var(--color-primary) 50%, transparent);
    color: var(--color-primary);
  }
  [data-og][data-sound='false'] .og-verdict {
    border-color: color-mix(in srgb, var(--color-error) 50%, transparent);
    color: var(--color-error);
  }
</style>
