---
import { Icon } from 'astro-icon/components'

// The pill chip used for status and access labels inside diagrams: READ / WRITE
// on the system map, PASS / REF on the turn trace. Three variants on the one
// commitment axis the design system already uses:
//   neutral: hairline on paper (a plain label, no emphasis)
//   safe:    green text on a faint green wash (the guard cleared it)
//   solid:   filled green (the one committed, high-signal state: a write, a ref)
// Green is reserved for genuinely-safe states, per DESIGN.md; never use `solid`
// or `safe` for a danger or error label.
type Variant = 'neutral' | 'safe' | 'solid'

interface Props {
  label: string
  variant?: Variant
  icon?: string
  class?: string
}
const { label, variant = 'neutral', icon, class: className = '' } = Astro.props

const styles: Record<Variant, string> = {
  neutral: 'text-text-muted bg-surface border border-border-dark',
  safe: 'text-primary bg-primary/10',
  solid: 'bg-primary text-on-primary',
}
---

<span
  class:list={[
    'inline-flex items-center gap-1 rounded-full font-mono text-mono-xs uppercase tracking-wider px-2 py-0.5',
    styles[variant],
    className,
  ]}
>
  {icon && <Icon name={icon} class="text-[15px]" />}
  {label}
</span>
