---
import DiagramLabel from './DiagramLabel.astro'
// Atlas's real two arm comparison, reproducible with:
//   uv run python -m evals.ab_study
// Two local ollama arms, 50 cases each, recorded through the gateway and replayed.
//
// A note on WHICH number is drawn here. The graded metric is saturated: both arms score 50/50 =
// 1.0000 [0.9287, 1.0000], because the render guard refuses anything false before it ships, so that
// comparison measures the GUARD and not the model. The arms do differ one layer up, in how often
// they needed the guard, and that is the honest place to look for a difference. So this figure draws
// the handoff rate, straight from the study's own secondary block:
//   arm A  5/50 = 0.1000  [0.0435, 0.2136]
//   arm B  8/50 = 0.1600  [0.0834, 0.2851]
//   intervals_overlap: True
//   verdict: NO CLAIM on the handoff rate either
// Points 6 apart, intervals overlapping. That is the lesson, and it happened rather than being set up.
//
// There is NO paired test here, and the omission is deliberate rather than an oversight. The rebuild
// computes no McNemar, no permutation test, no paired bootstrap and no power analysis anywhere; the
// stance is intervals plus lower bound gating. That costs POWER, not honesty: an unpaired comparison
// will miss real improvements a paired test would have found. An earlier draft of this figure quoted
// p = 0.553 (permutation) and 0.549 (exact McNemar) from a `task benchmark` artifact. No such task,
// artifact or test exists in the rebuilt tree, and those p values are gone rather than restated.
const A = { passes: 5, rate: 0.1, lo: 0.0435, hi: 0.2136 }
const B = { passes: 8, rate: 0.16, lo: 0.0834, hi: 0.2851 }
const N = 50

// Domain of the track: zoom to [0, 0.35] so 50 items' worth of interval is legible.
const LO = 0
const TOP = 0.35
const SPAN = TOP - LO
const pos = (x: number) => ((x - LO) / SPAN) * 100
const pct = (x: number) => `${(x * 100).toFixed(1)}%`
const rows = [
  { key: 'a', name: 'arm A · ollama:qwen2.5:7b', ...A },
  { key: 'b', name: 'arm B · ollama:qwen3.5:9b', ...B },
]
// The intervals-mode verdict, built from the measured numbers so the prose cannot drift from them.
const intervalsCaption =
  `Arm B needed the guard 6 points more often, and the 95% intervals overlap heavily ` +
  `([${pct(A.lo)}, ${pct(A.hi)}] against [${pct(B.lo)}, ${pct(B.hi)}]), so the study reports ` +
  `NO CLAIM. Fifty cases per arm cannot separate these two. Note what is NOT here: no p value, ` +
  `because the rebuild runs no significance test at all. That is a choice, and it costs power rather ` +
  `than honesty.`
---

{/* Statically rendered in intervals mode — the honest reading — so a no-JS render or an
    extracted snapshot never quotes the misleading points-only view. The script flips the
    interactive experience back to points on init so the toggle pedagogy is unchanged. */}
<figure class="not-prose my-10 border border-border-dark bg-surface rounded-lg p-5 show-intervals" data-bv data-inview>
  <div class="mb-4 flex items-center gap-2">
    <DiagramLabel label="The difference that wasn't: 5 vs 8 handoffs on n=50 per arm" />
    <div class="h-px flex-1 bg-border-dark"></div>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-6" role="group" aria-label="How to read the two scores">
    <span class="font-mono text-mono-xs text-text-muted mr-1" aria-hidden="true">Read as:</span>
    <button type="button" class="bv-toggle inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark text-text-muted transition-colors" data-bv-mode="points" aria-pressed="false">
      two points
    </button>
    <button type="button" class="bv-toggle on inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark transition-colors" data-bv-mode="intervals" aria-pressed="true">
      two intervals
    </button>
  </div>

  <div class="space-y-5" aria-hidden="true">
    {
      rows.map((r) => (
        <div>
          <div class="flex items-baseline justify-between mb-1.5 font-mono text-mono-xs">
            <span class="text-text-primary">{r.name}</span>
            <span class="text-text-muted">{r.passes}/{N} · <span class="text-text-primary">{pct(r.rate)}</span> <span class="bv-ci" data-bv-ci>(95% CI {pct(r.lo)}–{pct(r.hi)})</span></span>
          </div>
          <div class="bv-track relative h-3 w-full" data-bv-track>
            <div class="bv-bar absolute inset-y-0" data-bv-bar style={`left:${pos(r.lo)}%;width:${pos(r.hi) - pos(r.lo)}%`}></div>
            <div class="bv-dot absolute top-1/2 -translate-x-1/2 -translate-y-1/2" style={`left:${pos(r.rate)}%`}></div>
          </div>
        </div>
      ))
    }
    <div class="relative font-mono text-mono-xs text-text-muted pt-1">
      <span>{pct(LO)}</span>
      <span class="float-right">{pct(TOP)}</span>
    </div>
  </div>

  <figcaption class="m-0 mt-5 border-t border-border-dark pt-4 font-mono text-mono-xs text-text-muted" data-bv-caption data-bv-intervals-caption={intervalsCaption} aria-live="polite">
    {intervalsCaption}
  </figcaption>
</figure>

<style is:global>
  [data-bv] .bv-toggle.on {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }
  [data-bv] .bv-track {
    background: var(--color-surface-container-high);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-full);
  }
  /* the interval span is hidden in points mode and revealed in intervals mode */
  [data-bv] .bv-bar {
    background: color-mix(in srgb, var(--color-text-muted) 35%, transparent);
    border-radius: var(--radius-full);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out-quint);
  }
  [data-bv].show-intervals .bv-bar {
    transform: scaleX(1);
  }
  [data-bv] .bv-dot {
    width: 11px;
    height: 11px;
    border-radius: var(--radius-full);
    background: var(--color-text-primary);
    box-shadow: 0 0 0 3px var(--color-surface);
  }
  /* the CI text in the row label only shows alongside the intervals */
  [data-bv] .bv-ci {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  [data-bv].show-intervals .bv-ci {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-bv] .bv-bar,
    [data-bv] .bv-ci {
      transition: none;
    }
  }
</style>
