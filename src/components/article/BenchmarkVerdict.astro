---
import DiagramLabel from './DiagramLabel.astro'
// The cold open as a committed artifact, straight from the Atlas repo (`task benchmark`).
// Two model versions over the same 100 item answer golden: v_a 84/100, v_b 81/100. Read as
// points it is a three point regression; read as intervals it is noise. Toggle between the two
// readings: the point dots look far apart, the Wilson intervals overlap, and the paired test
// (permutation + exact McNemar) returns a p well above 0.05 with a difference CI that straddles
// zero. Numbers are the committed artifact's, not illustrative. Keep in sync with
// testing/harness/evals/benchmark/artifacts/benchmark_study.json if the fixture or seed changes.
const A = { passes: 84, rate: 0.84, lo: 0.756, hi: 0.899 }
const B = { passes: 81, rate: 0.81, lo: 0.722, hi: 0.875 }
const N = 100
const DIFF = 0.03
const DIFF_LO = -0.03
const DIFF_HI = 0.1
const PERM_P = 0.553
const MCNEMAR_P = 0.549

// Domain of the track: zoom to [0.65, 1.0] so 100 items' worth of interval is legible.
const LO = 0.65
const SPAN = 1.0 - LO
const pos = (x: number) => ((x - LO) / SPAN) * 100
const pct = (x: number) => `${(x * 100).toFixed(1)}%`
const rows = [
  { key: 'a', name: 'v_a (in production)', ...A },
  { key: 'b', name: 'v_b (the candidate)', ...B },
]
const sign = (x: number) => (x >= 0 ? `+${x.toFixed(2)}` : x.toFixed(2))
// The intervals-mode verdict, built from the committed numbers so the prose cannot drift from them.
const intervalsCaption =
  `The 95% intervals overlap, the paired difference is ${sign(DIFF)} with a bootstrap CI of ` +
  `[${DIFF_LO.toFixed(2)}, ${DIFF_HI.toFixed(2)}] that contains zero, and the paired tests return ` +
  `p = ${PERM_P.toFixed(2)} (permutation) and ${MCNEMAR_P.toFixed(2)} (exact McNemar). ` +
  `Verdict: you cannot tell yet, so you cannot ship "v_a is better."`
---

{/* Statically rendered in intervals mode — the honest reading — so a no-JS render or an
    extracted snapshot never quotes the misleading points-only view. The script flips the
    interactive experience back to points on init so the toggle pedagogy is unchanged. */}
<figure class="not-prose my-10 border border-border-dark bg-surface rounded-lg p-5 show-intervals" data-bv data-inview>
  <div class="mb-4 flex items-center gap-2">
    <DiagramLabel label="The regression that wasn't: 84 vs 81 on n=100" />
    <div class="h-px flex-1 bg-border-dark"></div>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-6" role="group" aria-label="How to read the two scores">
    <span class="font-mono text-mono-xs text-text-muted mr-1" aria-hidden="true">Read as:</span>
    <button type="button" class="bv-toggle inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark text-text-muted transition-colors" data-bv-mode="points" aria-pressed="false">
      two points
    </button>
    <button type="button" class="bv-toggle on inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark transition-colors" data-bv-mode="intervals" aria-pressed="true">
      two intervals
    </button>
  </div>

  <div class="space-y-5" aria-hidden="true">
    {
      rows.map((r) => (
        <div>
          <div class="flex items-baseline justify-between mb-1.5 font-mono text-mono-xs">
            <span class="text-text-primary">{r.name}</span>
            <span class="text-text-muted">{r.passes}/{N} · <span class="text-text-primary">{pct(r.rate)}</span> <span class="bv-ci" data-bv-ci>(95% CI {pct(r.lo)}–{pct(r.hi)})</span></span>
          </div>
          <div class="bv-track relative h-3 w-full" data-bv-track>
            <div class="bv-bar absolute inset-y-0" data-bv-bar style={`left:${pos(r.lo)}%;width:${pos(r.hi) - pos(r.lo)}%`}></div>
            <div class="bv-dot absolute top-1/2 -translate-x-1/2 -translate-y-1/2" style={`left:${pos(r.rate)}%`}></div>
          </div>
        </div>
      ))
    }
    <div class="relative font-mono text-mono-xs text-text-muted pt-1">
      <span>{pct(LO)}</span>
      <span class="float-right">100%</span>
    </div>
  </div>

  <figcaption class="m-0 mt-5 border-t border-border-dark pt-4 font-mono text-mono-xs text-text-muted" data-bv-caption data-bv-intervals-caption={intervalsCaption} aria-live="polite">
    {intervalsCaption}
  </figcaption>
</figure>

<style is:global>
  [data-bv] .bv-toggle.on {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }
  [data-bv] .bv-track {
    background: var(--color-surface-container-high);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-full);
  }
  /* the interval span is hidden in points mode and revealed in intervals mode */
  [data-bv] .bv-bar {
    background: color-mix(in srgb, var(--color-text-muted) 35%, transparent);
    border-radius: var(--radius-full);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out-quint);
  }
  [data-bv].show-intervals .bv-bar {
    transform: scaleX(1);
  }
  [data-bv] .bv-dot {
    width: 11px;
    height: 11px;
    border-radius: var(--radius-full);
    background: var(--color-text-primary);
    box-shadow: 0 0 0 3px var(--color-surface);
  }
  /* the CI text in the row label only shows alongside the intervals */
  [data-bv] .bv-ci {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  [data-bv].show-intervals .bv-ci {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-bv] .bv-bar,
    [data-bv] .bv-ci {
      transition: none;
    }
  }
</style>
