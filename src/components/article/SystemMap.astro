---
import { Icon } from 'astro-icon/components'
import DiagramFigure from './DiagramFigure.astro'
import Tag from './Tag.astro'

// The whole system on one page. Drawn so the structure carries the meaning the
// mermaid box-and-arrow could not: the guard is a real membrane that ENCLOSES
// the core (not a node beside it), the tool surfaces are a labelled column of
// reach (READ vs the single WRITE surface), and the harness is the plinth the
// whole stack visibly rests on.
//
// These were three MCP servers. MCP was removed from Atlas entirely, about 1,100
// lines, and the tools are now a plain registry in agent/tools/. The counts below
// are the real binding sets and sum to the 15 registered tools:
//   uv run python -c "from agent.tools.registry import SURFACE_BINDING as S; \
//     print({k: len(v) for k, v in S.items()})"
//   -> {'knowledge': 1, 'account': 5, 'catalog': 4, 'write': 5}

interface Surface {
  name: string
  detail: string
  icon: string
  access: 'READ' | 'WRITE'
  // the one write surface is where consequence pools, so it carries the only
  // filled accent; reads stay on hairline neutrals.
  accent: boolean
}

const servers: Surface[] = [
  {
    name: 'knowledge · 1 tool',
    detail: 'lexical retrieval over the corpus',
    icon: 'material-symbols:menu-book-outline',
    access: 'READ',
    accent: false,
  },
  {
    name: 'account + catalog · 9 tools',
    detail: 'the oracle · source of truth',
    icon: 'material-symbols:database-outline',
    access: 'READ',
    accent: false,
  },
  {
    name: 'write · 5 tools',
    detail: 'changes the account',
    icon: 'material-symbols:bolt',
    access: 'WRITE',
    accent: true,
  },
]

const ariaLabel =
  'The whole Atlas system on one page. An authenticated chat front door, whose identity comes from the session, feeds a LangGraph agent core that runs the model gateway and the per-customer cache. The core is enclosed by a fail-closed guard that checks before every action and every render. From inside, the core reaches fifteen tools across three surfaces, bound per intent: a read-only knowledge surface of one tool, a read-only account and catalog oracle of nine, and a single write-capable surface of five. The whole stack rests on the test harness, which seeds the stores, records and replays the model, and traces every turn.'
---

<DiagramFigure
  label="Atlas on one page"
  icon="material-symbols:schema-outline"
  ariaLabel={ariaLabel}
  stagger
  data-sm
>
  <div class="flex flex-col gap-3">
    {/* top row: chat in, then guard-wrapped core reaching the server column */}
    <div class="grid grid-cols-1 md:grid-cols-[minmax(0,7.5rem)_auto_1fr] md:items-center gap-3">
      {/* the front door */}
      <div
        class="flex flex-col gap-1 rounded border border-border-dark bg-surface-container-low px-4 py-3"
        data-stagger-item
        style="--d:0.05s"
      >
        <span class="font-mono text-mono-xs text-text-muted uppercase tracking-wider inline-flex items-center gap-1.5">
          <Icon name="material-symbols:chat-outline" class="text-[15px]" />
          Chat
        </span>
        <span class="text-sm text-text-primary font-medium leading-snug">Front door</span>
        <span class="font-mono text-mono-xs text-text-muted leading-tight">identity from session</span>
      </div>

      {/* connector: horizontal on desktop, vertical on mobile so the first hop
          survives the stack */}
      <div
        class="flex md:flex-col items-center justify-center text-text-muted gap-1"
        data-stagger-item
        style="--d:0.15s"
      >
        <span class="font-mono text-mono-xs uppercase tracking-wider">turn</span>
        <Icon name="material-symbols:sync-alt" class="text-[18px] rotate-90 md:rotate-0" />
      </div>

      {/* the guard membrane enclosing the core */}
      <div
        class="relative rounded-lg border border-primary/40 bg-primary/5 px-4 pt-7 pb-4"
        data-stagger-item
        style="--d:0.25s"
      >
        <span
          class="absolute -top-2.5 left-4 inline-flex items-center gap-1.5 rounded-full bg-surface border border-primary/40 px-2.5 py-0.5 font-mono text-mono-xs uppercase tracking-wider text-primary whitespace-nowrap"
        >
          <Icon name="material-symbols:shield-outline" class="text-[14px]" />
          Guard · fail-closed
        </span>
        <div class="rounded border border-border-dark bg-surface px-4 py-3">
          <span class="font-mono text-mono-xs text-text-primary uppercase tracking-wider inline-flex items-center gap-1.5">
            <Icon name="material-symbols:hub-outline" class="text-[15px]" />
            Agent core · LangGraph StateGraph
          </span>
          <p class="m-0 mt-0.5 font-mono text-mono-xs text-text-muted leading-tight">
            checked before every action + render
          </p>
          <div class="mt-2 flex flex-wrap gap-1.5">
            <span class="font-mono text-mono-xs text-text-muted rounded border border-border-dark bg-surface-container-low px-2 py-0.5">
              model gateway · record / replay
            </span>
            <span class="font-mono text-mono-xs text-text-muted rounded border border-border-dark bg-surface-container-low px-2 py-0.5">
              per customer cache · key includes customer_id
            </span>
          </div>
        </div>
      </div>
    </div>

    {/* per-intent reach: the three tool surfaces */}
    <div class="flex items-center gap-2 mt-1 text-text-muted pl-1" data-stagger-item style="--d:0.4s">
      <Icon name="material-symbols:arrow-downward" class="text-[16px]" />
      <span class="font-mono text-mono-xs uppercase tracking-wider">reaches, per intent</span>
      <span class="h-px flex-1 bg-border-dark"></span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      {
        servers.map((s, i) => (
          <div
            class:list={[
              'flex flex-col gap-1 rounded border px-4 py-3',
              s.accent ? 'border-primary/60 bg-primary/10' : 'border-border-dark bg-surface-container-low',
            ]}
            data-stagger-item
            style={`--d:${(0.5 + i * 0.08).toFixed(2)}s`}
          >
            <div class="flex items-center justify-between gap-2">
              <Icon
                name={s.icon}
                class:list={['text-[18px]', s.accent ? 'text-primary' : 'text-text-muted']}
              />
              <Tag label={s.access} variant={s.accent ? 'solid' : 'neutral'} />
            </div>
            <span class="text-sm text-text-primary font-medium leading-snug mt-1">{s.name}</span>
            <span class="font-mono text-mono-xs text-text-muted leading-tight">{s.detail}</span>
          </div>
        ))
      }
    </div>

    {/* the plinth the whole stack rests on */}
    <div
      class="sm-plinth mt-1 flex flex-col gap-1 rounded border border-dashed border-primary/30 bg-surface-container-high px-4 py-3"
      data-stagger-item
      style="--d:0.78s"
    >
      <span class="font-mono text-mono-xs text-text-muted uppercase tracking-wider inline-flex items-center gap-1.5">
        <Icon name="material-symbols:foundation" class="text-[15px]" />
        Harness · the ground everything above stands on
      </span>
      <span class="font-mono text-mono-xs text-text-muted leading-tight">
        seeds the stores · records / replays the model · blocks egress · traces every turn
      </span>
    </div>
  </div>

  <Fragment slot="note">
    Read it top to bottom. The core decides and, per intent, is handed a subset of
    the fifteen tools, wrapped the whole time in a guard that can stop an action or
    a render. Everything this series does is somewhere on this picture.
  </Fragment>
</DiagramFigure>

<style is:global>
  /* The plinth reads as a substrate, not another sibling card: it spans the
   * figure's full width and sits flush under the stack with a hairline lip. */
  [data-sm] .sm-plinth {
    box-shadow: inset 0 2px 0 0 color-mix(in srgb, var(--color-primary) 12%, transparent);
  }
</style>
