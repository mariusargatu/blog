---
// Thin progress bar pinned to the top of the viewport. Width is driven by the
// --read-progress custom property, updated in article-ui.ts.
---

<div
  id="read-progress"
  class="read-progress fixed top-0 left-0 w-full h-[2px] bg-primary z-[60]"
>
</div>

<script>
  import { initReadingProgress } from '../../scripts/article-ui'

  const bar = document.getElementById('read-progress')
  if (bar) initReadingProgress(bar)
</script>
