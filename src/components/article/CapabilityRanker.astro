---
import DiagramLabel from './DiagramLabel.astro'
// The closing exercise, interactive: set each capability's consequence; the list
// re-ranks and the top three light up with the patterns they need. Everything
// below is "evals + monitoring sufficient."
const PATTERN_LABEL: Record<string, string> = {
  P1: 'Pattern 1 · independent truth',
  P2: 'Pattern 2 · output validation',
  P3: 'Pattern 3 · adversarial',
  P4: 'Pattern 4 · trajectory',
  arch: 'Architecture',
}

const caps = [
  { id: 'refund', name: 'Refund / policy answers', worst: 'States the opposite of policy → legal liability', consequence: 'high', patterns: ['P1', 'P2'] },
  { id: 'tools', name: 'Agent tool actions (refunds, tickets)', worst: 'Unauthorized financial action', consequence: 'high', patterns: ['P2', 'P3', 'arch'] },
  { id: 'tenant', name: 'Cross-tenant data access', worst: "One customer sees another's data", consequence: 'high', patterns: ['arch', 'P3'] },
  { id: 'summarize', name: 'Internal doc summarization', worst: 'Minor inaccuracy, low stakes', consequence: 'low', patterns: ['P1'] },
  { id: 'tone', name: 'Tone / style suggestions', worst: 'Awkward phrasing', consequence: 'low', patterns: ['P2'] },
]
const levels = [
  { k: 'low', t: 'L', name: 'Low' },
  { k: 'med', t: 'M', name: 'Medium' },
  { k: 'high', t: 'H', name: 'High' },
]
---

<div class="not-prose my-10 border border-border-dark bg-surface rounded-lg p-5" data-cr>
  <div class="mb-1 flex items-center gap-2">
    <DiagramLabel label="Rank by consequence: your draft risk register" />
    <div class="h-px flex-1 bg-border-dark"></div>
  </div>
  <p class="m-0 mb-5 font-mono text-mono-xs text-text-muted">
    Set each capability's worst-case consequence. The top three are where the
    testing program starts.
  </p>

  <div class="flex flex-col gap-2" data-cr-list>
    {/* is-top / is-low and the rank number are server-rendered from the
        initial order (already sorted high→low) so a no-JS render shows
        the honest reading: low-consequence rows get "Evals + monitoring
        sufficient", not "start here". JS recompute() re-derives on load. */}
    {
      caps.map((c, i) => (
        <div class:list={['cr-row border border-border-dark bg-surface-container-low p-4 flex flex-col gap-3', i < 3 ? 'is-top' : 'is-low']} data-cr-row data-index={i} data-consequence={c.consequence}>
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="cr-rank font-mono text-mono-xs text-primary" data-cr-rank>{String(i + 1).padStart(2, '0')}</span>
                <p class="m-0 text-text-primary font-medium">{c.name}</p>
              </div>
              <p class="m-0 mt-1 font-mono text-mono-xs text-text-muted">↳ {c.worst}</p>
            </div>
            <div class="flex items-center gap-1 shrink-0" role="group" aria-label="Consequence">
              {levels.map((l) => (
                <button
                  type="button"
                  class:list={['cr-lvl inline-flex items-center justify-center font-mono text-mono-xs w-11 h-11 border', l.k === c.consequence ? 'cr-lvl-on' : '']}
                  data-cr-lvl={l.k}
                  aria-label={`${l.name} consequence`}
                  aria-pressed={l.k === c.consequence ? 'true' : 'false'}
                >
                  {l.t}
                </button>
              ))}
            </div>
          </div>

          <div class="cr-rec flex flex-wrap items-center gap-2 pt-1">
            <span class="cr-rec-top font-mono text-mono-xs text-tertiary uppercase tracking-wider">▶ start here</span>
            {c.patterns.map((p) => (
              <span class="cr-chip cr-rec-top font-mono text-mono-xs px-2 py-0.5 border border-primary/40 text-primary bg-primary/5">
                {PATTERN_LABEL[p]}
              </span>
            ))}
            <span class="cr-rec-low font-mono text-mono-xs text-text-muted">Evals + monitoring sufficient</span>
          </div>
        </div>
      ))
    }
  </div>
  <p class="sr-only" data-cr-status aria-live="polite"></p>
</div>

<style is:global>
  [data-cr] .cr-lvl {
    border-color: var(--color-border-dark);
    color: var(--color-text-muted);
    transition: all 0.18s ease;
  }
  [data-cr] .cr-lvl-on {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }
  [data-cr] .cr-lvl:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  [data-cr] .cr-row {
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  [data-cr] .cr-row.is-top {
    border-color: color-mix(in srgb, var(--color-tertiary) 50%, transparent);
  }
  /* rows carry is-top / is-low from static markup; the low note replaces
     start-here on is-low rows with or without JS */
  [data-cr] .cr-rec-low {
    display: none;
  }
  [data-cr] .cr-row.is-low .cr-rec-top {
    display: none;
  }
  [data-cr] .cr-row.is-low .cr-rec-low {
    display: inline;
  }
</style>
