---
import DiagramLabel from './DiagramLabel.astro'

// The retry storm story, made survivable by one key. A write times out and the
// orchestrator tries again, three times. Without a key, each attempt is a fresh
// change and the backend may hold three plan changes where the customer asked
// for one. With an idempotency key, minted once when the action was proposed and
// riding in the call context rather than any argument the model controls, the
// stateful backend recognises the key, applies the change once, and returns the
// original result for every repeat. Three retries on one key are one plan change.
// Because the key lives outside the model's reach, the model cannot reset it,
// reuse it, or talk its way into a fresh one.

const attempts = [
  { n: 1, outcome: 'timed out' },
  { n: 2, outcome: 'timed out' },
  { n: 3, outcome: 'returned ok' },
]
const KEY = 'idem:9f3a…'
---

{/* Statically rendered with the key on, the safe design, so a no-JS render shows
    three retries collapsing to one change. The script inits to "without key" so
    the retry storm landmine is shown on load. */}
<figure class="not-prose my-10 border border-border-dark bg-surface rounded-lg p-5" data-ik data-keyed="true" data-inview>
  <div class="mb-4 flex items-center gap-2">
    <DiagramLabel label="Three retries, one change" />
    <div class="h-px flex-1 bg-border-dark"></div>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-5" role="group" aria-label="Whether the retried write carries an idempotency key">
    <span class="font-mono text-mono-xs text-text-muted mr-1" aria-hidden="true">Retried write:</span>
    <button type="button" class="ik-toggle inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark text-text-muted transition-colors" data-ik-mode="off" aria-pressed="false">
      without a key
    </button>
    <button type="button" class="ik-toggle on inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark transition-colors" data-ik-mode="on" aria-pressed="true">
      with an idempotency key
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-4 items-center" aria-hidden="true">
    <div class="space-y-1.5">
      {
        attempts.map((a) => (
          <div class="ik-attempt flex items-center gap-3 rounded border border-border-dark bg-surface-container-low px-3 py-2">
            <span class="font-mono text-mono-xs text-text-muted w-16 shrink-0">retry {a.n}</span>
            <span class="flex-1 text-sm text-text-primary">write {a.outcome}</span>
            <code class="ik-key font-mono text-mono-xs shrink-0" data-ik-key>{KEY}</code>
          </div>
        ))
      }
    </div>

    <div class="ik-backend rounded border px-5 py-4 text-center" data-ik-backend>
      <span class="block font-mono text-mono-xs uppercase tracking-wider text-text-muted">Backend applied</span>
      <span class="ik-count block font-mono text-5xl leading-none mt-1" data-ik-count>1</span>
      <span class="block font-mono text-mono-xs text-text-muted mt-1" data-ik-noun>plan change</span>
    </div>
  </div>

  <figcaption class="m-0 mt-5 border-t border-border-dark pt-4 font-mono text-mono-xs text-text-muted" data-ik-caption aria-live="polite">
    With the key, the stateful backend recognises it, applies the change once, and returns the original result for every repeat. Three retries on one key are one plan change, and the key lives outside the model’s reach.
  </figcaption>
</figure>

<style is:global>
  [data-ik] .ik-toggle.on {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }
  [data-ik] .ik-key {
    color: var(--color-primary);
  }
  [data-ik][data-keyed='false'] .ik-key {
    color: var(--color-error);
    text-decoration: line-through;
  }
  [data-ik] .ik-backend {
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  [data-ik][data-keyed='true'] .ik-backend {
    border-color: color-mix(in srgb, var(--color-primary) 50%, transparent);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }
  [data-ik][data-keyed='true'] .ik-count {
    color: var(--color-primary);
  }
  [data-ik][data-keyed='false'] .ik-backend {
    border-color: var(--color-error);
    background: color-mix(in srgb, var(--color-error) 9%, transparent);
  }
  [data-ik][data-keyed='false'] .ik-count {
    color: var(--color-error);
  }
</style>
