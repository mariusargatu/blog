---
import { Icon } from 'astro-icon/components'

// Collapses a heavy interactive component by default so the article's resting
// cognitive load stays low; the reader opts in. Reuses the .accordion chevron.
interface Props {
  label: string
  open?: boolean
}
const { label, open = false } = Astro.props
---

<details class="accordion foldable not-prose my-6" open={open}>
  <summary
    class="group flex min-h-11 cursor-pointer items-center justify-between gap-3 py-3 border-b border-dashed border-border-dark"
  >
    <span class="inline-flex flex-wrap items-center gap-x-2.5 gap-y-1">
      <span
        class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-2.5 py-1 font-mono text-mono-xs uppercase tracking-wider text-primary"
      >
        <Icon name="material-symbols:touch-app-outline" class="text-[14px]" />
        Interactive
      </span>
      <span
        class="font-mono text-mono-xs uppercase tracking-wider text-text-primary group-hover:text-primary transition-colors"
        >{label}</span
      >
    </span>
    <Icon name="material-symbols:expand-more" class="acc-chevron text-primary text-[20px] shrink-0" />
  </summary>
  <div class="pt-4">
    <slot />
  </div>
</details>
