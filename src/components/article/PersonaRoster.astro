---
import DiagramFigure from './DiagramFigure.astro'

// A persona is a customer with a disposition and a goal, expressed well enough that
// a model plays it across many turns without breaking character. Each is a
// generator: point it at the agent, give it a goal, and one persona becomes a
// hundred conversations. This is Atlas's actual roster from evals/simulation/
// personas.py; the mind-changer is the one the hermetic gate exercises as a fixture.

const personas = [
  { name: 'mind-changer', disposition: 'reverses direction mid-conversation to see whether the agent keeps up', goal: 'switch to the faster plan, after rejecting a cheaper one' },
  { name: 'confused', disposition: 'describes the symptom, never the name of the plan', goal: 'find out why the connection dies every evening' },
  { name: 'impatient', disposition: 'treats every clarifying question as an obstacle', goal: 'get the plan changed without confirming twice' },
  { name: 'bargain-hunter', disposition: 'circles the same discount from new angles, politely', goal: 'talk the agent into a price it should not give' },
  { name: 'non-native-speaker', disposition: 'phrasing is correct but unidiomatic, the kind synthetic data never produces', goal: 'understand what the bill actually covers' },
]

const ariaLabel =
  "Atlas's persona roster, five customers each with a disposition and a goal. The mind-changer reverses direction mid-conversation to see whether the agent keeps up, aiming to switch to the faster plan after rejecting a cheaper one. The confused customer describes the symptom, never the plan name, wanting to know why the connection dies every evening. The impatient one treats every clarifying question as an obstacle and wants the change made without confirming twice. The bargain hunter circles the same discount from new angles, trying to talk the agent into a price it should not give. The non-native speaker phrases things correctly but unidiomatically, the kind of input synthetic data never produces, wanting to understand the bill. Each persona is a generator: one persona becomes a hundred conversations."
---

<DiagramFigure label="The persona roster (evals/simulation/personas.py)" ariaLabel={ariaLabel} data-pr>
  <ul class="m-0 grid grid-cols-1 md:grid-cols-2 gap-3 list-none p-0">
    {
      personas.map((p) => (
        <li class="pr-card rounded border px-3 py-3">
          <span class="pr-name inline-block font-mono text-mono-xs px-2 py-0.5 rounded">{p.name}</span>
          <span class="block text-sm text-text-primary mt-2 leading-snug">{p.disposition}</span>
          <span class="block font-mono text-mono-xs text-text-muted mt-1.5 leading-snug">goal: {p.goal}</span>
        </li>
      ))
    }
  </ul>

  <Fragment slot="note">
    Five personas become a corpus no team of authors could afford to write. And nothing requires a
    persona's goal to be honest: the bargain hunter and the social engineer are the same machine with a
    different goal, so this roster is also half the security suite.
  </Fragment>
</DiagramFigure>

<style is:global>
  [data-pr] .pr-card {
    border-color: var(--color-border-dark);
    background: var(--color-surface-container-low);
  }
  [data-pr] .pr-name {
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  }
</style>
