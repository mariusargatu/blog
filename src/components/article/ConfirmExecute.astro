---
import DiagramLabel from './DiagramLabel.astro'

// The propose, confirm, execute gate, made switchable. The graph runs to the point
// of action, mints the action it intends to take, then interrupts and persists
// that pending action into a durable checkpoint. Nothing has happened yet. When
// the yes arrives, what does the orchestrator execute? Execute the latest model
// output and the confirmation is a second roll of the dice: the agent can
// propose one thing, collect a yes, and do another. Execute the stored pending
// action and the yes means yes to the specific thing the customer actually saw.
// The control is what runs on confirm; the safety follows from it.

const proposed = 'change_plan → plan_id "plan_current_fast"'
const executed = {
  latest: { call: 'change_plan → plan_id "plan_legacy_value"', match: false },
  stored: { call: 'change_plan → plan_id "plan_current_fast"', match: true },
}
---

{/* Statically rendered in "stored pending action" mode, the safe design, so a
    no-JS render never shows the confirmation resolving to a fresh generation.
    The script inits to "latest model output" on load so the toggle pedagogy
    (the confirmation as a second roll of the dice) is intact. */}
<figure class="not-prose my-10 border border-border-dark bg-surface rounded-lg overflow-hidden" data-ce data-safe="true" data-inview>
  <div class="flex items-center justify-between gap-4 px-5 py-3 bg-surface-container-high border-b border-border-dark flex-wrap">
    <DiagramLabel label="On yes, what does it execute?" />
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="What the orchestrator executes on confirmation">
      <button type="button" class="ce-toggle inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark text-text-muted transition-colors" data-ce-mode="latest" aria-pressed="false">
        the latest model output
      </button>
      <button type="button" class="ce-toggle on inline-flex items-center font-mono text-mono-xs px-3 min-h-11 border border-border-dark transition-colors" data-ce-mode="stored" aria-pressed="true">
        the stored pending action
      </button>
    </div>
  </div>

  <div class="p-5">
    <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr] items-stretch gap-3">
      <div class="ce-box rounded border border-border-dark bg-surface-container-low px-4 py-3">
        <span class="block font-mono text-mono-xs uppercase tracking-wider text-text-muted">Proposed, then checkpointed</span>
        <code class="block font-mono text-sm text-text-primary mt-1 leading-snug">{proposed}</code>
        <span class="block font-mono text-mono-xs text-text-muted mt-2">customer sees this, says “yes”</span>
      </div>

      <div class="hidden sm:flex items-center justify-center font-mono text-mono-xs text-text-muted" aria-hidden="true">→</div>

      <div class="ce-exec rounded border px-4 py-3" data-ce-exec>
        <span class="block font-mono text-mono-xs uppercase tracking-wider text-text-muted">Executed on confirm</span>
        <code class="block font-mono text-sm text-text-primary mt-1 leading-snug" data-ce-call>{executed.stored.call}</code>
        <span class="ce-match block font-mono text-mono-xs mt-2" data-ce-match>matches what the customer saw</span>
      </div>
    </div>

    <p class="ce-verdict m-0 mt-4 flex items-start gap-2 rounded border px-4 py-3 font-mono text-mono-xs leading-relaxed" data-ce-verdict aria-live="polite">
      Resume from the checkpoint and execute the stored pending action: the yes means yes to the exact thing proposed and saved. Where you put that checkpoint boundary is the definition of idempotency for the whole system.
    </p>
  </div>
</figure>

<style is:global>
  [data-ce] .ce-toggle.on {
    border-color: var(--color-text-primary);
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--color-text-primary) 6%, transparent);
  }
  [data-ce] .ce-exec {
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  [data-ce][data-safe='true'] .ce-exec {
    border-color: color-mix(in srgb, var(--color-success) 50%, transparent);
    background: color-mix(in srgb, var(--color-success) 8%, transparent);
  }
  [data-ce][data-safe='false'] .ce-exec {
    border-color: var(--color-error);
    background: color-mix(in srgb, var(--color-error) 9%, transparent);
  }
  [data-ce][data-safe='true'] .ce-match {
    color: var(--color-success);
  }
  [data-ce][data-safe='false'] .ce-match {
    color: var(--color-error);
  }
  [data-ce] .ce-verdict {
    transition: border-color 0.25s ease, background-color 0.25s ease, color 0.25s ease;
  }
  [data-ce][data-safe='true'] .ce-verdict {
    border-color: color-mix(in srgb, var(--color-success) 50%, transparent);
    background: color-mix(in srgb, var(--color-success) 8%, transparent);
    color: var(--color-text-primary);
  }
  [data-ce][data-safe='false'] .ce-verdict {
    border-color: var(--color-error);
    background: color-mix(in srgb, var(--color-error) 9%, transparent);
    color: var(--color-text-primary);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ce]')
  if (root) {
    const executed: Record<string, { call: string; match: boolean }> = {
      latest: { call: 'change_plan → plan_id "plan_legacy_value"', match: false },
      stored: { call: 'change_plan → plan_id "plan_current_fast"', match: true },
    }
    const toggles = [...root.querySelectorAll<HTMLButtonElement>('[data-ce-mode]')]
    const callEl = root.querySelector<HTMLElement>('[data-ce-call]')!
    const matchEl = root.querySelector<HTMLElement>('[data-ce-match]')!
    const verdictEl = root.querySelector<HTMLElement>('[data-ce-verdict]')!

    const captions: Record<string, string> = {
      latest:
        'Execute the latest model output and the confirmation is a second roll of the dice: the agent proposed one plan, collected a yes, and generated another on the fresh turn. The customer agreed to a thing that did not happen.',
      stored:
        'Resume from the checkpoint and execute the stored pending action: the yes means yes to the exact thing proposed and saved. Where you put that checkpoint boundary is the definition of idempotency for the whole system.',
    }

    const render = (mode: string) => {
      const e = executed[mode]
      root.dataset.safe = String(e.match)
      callEl.textContent = e.call
      matchEl.textContent = e.match ? 'matches what the customer saw' : 'differs from what the customer saw'
      verdictEl.textContent = captions[mode]
      toggles.forEach((t) => {
        const on = t.dataset.ceMode === mode
        t.classList.toggle('on', on)
        t.setAttribute('aria-pressed', String(on))
      })
    }

    toggles.forEach((t) => t.addEventListener('click', () => render(t.dataset.ceMode!)))
    render('latest')
  }
</script>
