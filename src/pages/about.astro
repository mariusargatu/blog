---
import { Icon } from 'astro-icon/components'
import BaseLayout from '../layouts/BaseLayout.astro'

const linkedin = 'https://www.linkedin.com/in/mariusargatu'
const github = 'https://github.com/mariusargatu'
const email = 'mailto:contact@mariusargatu.com'

// ProfilePage + Person JSON-LD. Defines the canonical Person entity that the
// article schema references by @id (.../about/#person), so author E-E-A-T
// resolves to one entity across the site.
const aboutUrl = new URL('about/', Astro.site).href
const personId = `${aboutUrl}#person`
const profileJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['ProfilePage', 'WebPage'],
      '@id': aboutUrl,
      url: aboutUrl,
      name: 'About, Marius Argatu',
      mainEntity: { '@id': personId },
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Marius Argatu',
      url: aboutUrl,
      jobTitle: 'Senior SDET, LLM Evaluation and AI Quality',
      description:
        'Senior SDET with ten years building test frameworks, runners and CI release gates for systems where reliability matters: regulated healthcare, airline payments, a payment service provider, fintech and market data. Since 2023 focused on LLM evaluation for RAG and agent systems.',
      sameAs: [linkedin, github],
    },
  ],
}

const competencies = [
  {
    title: 'LLM Evaluation',
    items:
      'Retrieval and generation scored separately: IR metrics on one side, groundedness and relevancy on the other. Golden datasets versioned, evaluation runs gated in CI. RAG and agent systems.',
  },
  {
    title: 'Test Architecture',
    items:
      'Test strategy across teams and products, and framework and runner design. Integration and system tests carry most of the coverage, following the testing trophy and honeycomb models. Model based testing from state machines, property based and metamorphic testing, contract testing.',
  },
  {
    title: 'Regulated Domains and Payments',
    items:
      'Multi tenant healthcare SaaS, payment endpoints, checkout and settlement flows, and the regression planning and release gate decisions around them.',
  },
  {
    title: 'Languages, APIs',
    items: 'Python, TypeScript, REST, GraphQL, OpenAPI',
  },
  {
    title: 'LLM and Eval',
    items:
      'DeepEval, RAGAS, Langfuse, golden datasets, RAG evaluation, agent evaluation, MCP',
  },
  {
    title: 'Test Tooling',
    items: 'Pytest, Vitest, Playwright, Hypothesis, Schemathesis, xState, Pydantic',
  },
  {
    title: 'Test Management',
    items: 'Jira, Xray, TestRail, Qase.io, Allure',
  },
  {
    title: 'Platform',
    items:
      'Docker, Kubernetes, Jenkins, GitHub Actions, GitLab CI, Datadog, OpenTelemetry, Grafana',
  },
]

interface Project {
  role: string
  period: string
  summary?: string
  points: string[]
  tags: string[]
}
interface Company {
  company: string
  period: string
  open: boolean
  summary?: string
  projects: Project[]
}
const experience: Company[] = [
  {
    company: 'Coherent Solutions',
    period: 'January 2022 to Present',
    open: true,
    summary:
      'Software consultancy. Each role below is a separate client engagement, not a separate employer.',
    projects: [
      {
        role: 'Senior SDET · Airline Retailing and Revenue Platform',
        period: 'July 2025 to Present',
        summary:
          'Quality engineering for payment services and for LLM based tooling inside the delivery workflow.',
        points: [
          'Own the quality strategy for my feature squad. What to test, at which level, and why. Developers write their own unit, integration and system tests; I review them and close the coverage gaps. Own regression planning and release gate decisions for the payments domain.',
          'Built an internal LLM powered debugging agent that correlates failing test output with Datadog traces, the live stack trace, and recent Jira changes, then iterates until the test passes or a real defect surfaces. Triage time cut from hours to minutes.',
          'Run agentic workflows in daily engineering: MCP servers for knowledge base retrieval, slash commands for bug triage, and agents for test maintenance.',
          'Maintain and extend the API test framework with fixtures, helpers and reusable modules, and drive coverage across new payment endpoints and business flows. Authored test scenarios during LLD design as the specification for developer written tests.',
        ],
        tags: ['Python', 'API', 'Datadog', 'MCP', 'Agentic Software Engineering'],
      },
      {
        role: 'Senior SDET · Multi Tenant Healthcare SaaS',
        period: 'January 2023 to July 2025',
        summary:
          "Regulated domain. Framework ownership and platform wide test architecture, plus the evaluation system for the product's RAG assistant and its agentic paths.",
        points: [
          'Built the LLM evaluation system for a RAG assistant answering researcher questions against FDA and EMA guidance and tenant submissions. Separated retrieval quality (hit rate, precision@k) from generation quality (faithfulness, answer relevancy) using RAGAS. Golden datasets versioned in Langfuse, evaluation runs gated in CI.',
          "Extended evaluation to the assistant's agentic paths, covering multi turn state, tool and function calling and planning loops, so tool selection and trajectory could be scored and not only the final answer.",
          'Built a model based testing system on the permissions matrix using xState. Roughly 1,000 test scenarios generated from a single state machine definition, tracking the product as permissions evolve with no manual rewrite.',
          'Built a Playwright and TypeScript test platform with page object model and fixture based tenant and role isolation, adopted across multiple functional teams.',
          'Built an AST based migration tool that translated a legacy Karate DSL suite into equivalent TypeScript and Playwright code, removing a manual rewrite of thousands of lines.',
          'Acted as framework SME: onboarding, test pattern reviews, and coordination on cross cutting changes including an auth system rewrite.',
        ],
        tags: ['RAGAS', 'Langfuse', 'xState', 'Playwright', 'TypeScript', 'RAG'],
      },
      {
        role: 'Test Architect · Native Qt Desktop Product',
        period: 'January 2022 to January 2023',
        summary:
          'Python and Pytest API framework, native desktop automation via patched Chromium.',
        points: [
          'Owned which layers we tested at, which tools we standardised on, and how automation was structured across the native and embedded web surfaces. Ran technical workshops on mutation testing and property based testing.',
          'Built a custom Pytest plugin that runs dependent API tests concurrently with ordering resolved by a DAG. Runtime reduced from 1 hour to roughly 5 minutes.',
          "Patched and rebuilt Qt WebEngine's Chromium fork to expose the remote debugging port, replacing Appium with Selenium via CDP. Per test effort dropped from 4 days to 1.",
          'Introduced contract testing between the client and its backing services, moving a class of integration tests to a cheaper and faster layer.',
        ],
        tags: ['Python', 'Pytest', 'Selenium', 'CDP', 'Qt', 'Contract Testing'],
      },
    ],
  },
  {
    company: 'LSEG (London Stock Exchange Group)',
    period: 'March 2021 to January 2022',
    open: false,
    projects: [
      {
        role: 'Senior QA Automation Engineer',
        period: 'March 2021 to January 2022',
        points: [
          'Designed a cross platform automation framework in Python using the Screenplay pattern, covering an SPA with Playwright and a Windows desktop client via WinAppDriver.',
          'Delivered an end to end suite that reduced manual regression on the desktop side, which had little automation before.',
          'Maintained and optimised Jenkins pipelines for execution and reporting across environments, and coordinated a small QA team.',
        ],
        tags: ['Python', 'Playwright', 'WinAppDriver', 'Screenplay', 'Jenkins'],
      },
    ],
  },
  {
    company: '2Checkout',
    period: 'March 2020 to March 2021',
    open: false,
    summary:
      'Payment service provider handling ecommerce checkout, subscription billing and cross border payment flows.',
    projects: [
      {
        role: 'QA Automation Engineer',
        period: 'March 2020 to March 2021',
        points: [
          'Led design of a Pytest based automation framework for complex ecommerce and payment workflows. The standards defined then are still in use.',
          'Built a database diff tool that captured state changes triggered by UI actions, letting QA snapshot and restore environments locally and validate results at the database level.',
          'Reduced test execution time through parallel execution and script optimisation.',
        ],
        tags: ['Python', 'Pytest', 'Payments'],
      },
    ],
  },
  {
    company: 'Amber',
    period: 'April 2017 to March 2020',
    open: false,
    summary:
      'One continuous tenure, moving from testing into production engineering.',
    projects: [
      {
        role: 'Backend Engineer',
        period: 'March 2019 to March 2020',
        points: [
          'Shipped RESTful APIs in Python and Flask, validated performance under load with k6, and maintained CI/CD on Docker and Kubernetes.',
        ],
        tags: ['Python', 'Flask', 'k6', 'Docker', 'Kubernetes'],
      },
      {
        role: 'Senior QA Tester',
        period: 'June 2018 to March 2019',
        points: [
          'Owned integration testing of REST services end to end, and organised daily QA across web, desktop and mobile.',
        ],
        tags: [],
      },
      {
        role: 'QA Tester',
        period: 'April 2017 to May 2018',
        points: [
          'Authored and evolved test cases against changing requirements, and ran regression cycles.',
        ],
        tags: [],
      },
    ],
  },
  {
    company: 'Electronic Arts (EA)',
    period: 'April 2016 to October 2016',
    open: false,
    projects: [
      {
        role: 'QA Tester',
        period: 'April 2016 to October 2016',
        points: ['End to end feature testing for AAA game titles across platforms.'],
        tags: [],
      },
    ],
  },
]

const ctaPrimary =
  'inline-flex items-center gap-2 bg-primary text-on-primary font-mono text-mono-label px-5 py-2.5 rounded-full hover:opacity-90 active:scale-95 transition-all'
const ctaGhost =
  'inline-flex items-center gap-2 font-mono text-mono-label text-text-primary border border-border-dark px-5 py-2.5 rounded-full hover:border-primary transition-all'
---

<BaseLayout
  title="About, Marius Argatu"
  description="Senior SDET, ten years building test frameworks, runners and CI release gates across regulated healthcare, airline payments, a payment service provider, fintech and market data. Since 2023 focused on LLM evaluation for RAG and agent systems. Contractor, Remote · EU Timezone."
>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(profileJsonLd)}
  />

  <main
    class="max-w-container-max mx-auto px-margin-mobile md:px-gutter pt-32 pb-section-gap"
    data-pagefind-body
  >
    <!-- Header -->
    <header class="mb-section-gap" data-reveal>
      <div class="flex items-center gap-2 mb-5">
        <span
          class="font-mono text-mono-label text-primary text-xs tracking-tighter"
          >ABOUT</span
        >
        <div class="h-px flex-1 bg-border-dark"></div>
      </div>
      <h1
        class="font-sans text-display-xl-mobile md:text-display-xl text-text-primary mb-3"
      >
        Marius Argatu
      </h1>
      <p class="text-body-lg text-text-muted mb-6 max-w-2xl">
        Senior SDET · LLM Evaluation and AI Quality · Test Architecture ·
        Regulated Healthcare and Payments
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <span
          class="font-mono text-mono-xs text-text-muted inline-flex items-center gap-2 border border-border-dark rounded-full px-3 py-1"
        >
          <span class="w-2 h-2 rounded-full bg-tertiary animate-pulse"></span>
          CONTRACTOR · REMOTE · EU TIMEZONE · BUCHAREST
        </span>
        <a href={email} class={ctaPrimary}>
          <Icon name="material-symbols:mail" class="text-[18px]" />
          Get in touch
        </a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class={ctaGhost}>
          <Icon name="material-symbols:link" class="text-[18px]" />
          LinkedIn
        </a>
        <a href={github} target="_blank" rel="noopener noreferrer" class={ctaGhost}>
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="currentColor"
            class="w-[18px] h-[18px]"
          >
            <path
              d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .98-.31 3.2 1.18a11.1 11.1 0 0 1 5.82 0c2.22-1.49 3.2-1.18 3.2-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.25 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"
            ></path>
          </svg>
          GitHub
        </a>
      </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
      <!-- Left: summary / competencies / education / languages -->
      <aside class="md:col-span-4 flex flex-col gap-10">
        <section data-reveal>
          <h2 class="font-mono text-mono-xs text-primary uppercase tracking-widest mb-4">
            _SUMMARY
          </h2>
          <p class="text-body-md text-text-muted leading-relaxed mb-4">
            Senior SDET with ten years building test frameworks, runners and CI
            release gates for systems where reliability matters. Regulated
            healthcare, airline payments, a payment service provider, fintech
            and market data. I work at the framework and infrastructure level
            rather than only writing tests, and I own what gets tested, at which
            level, and when a release ships.
          </p>
          <p class="text-body-md text-text-muted leading-relaxed mb-4">
            Since 2023 this has included LLM evaluation, two years of it on a
            regulated healthcare product: the evaluation system for a RAG
            assistant answering researcher questions against FDA and EMA
            guidance and tenant submissions. Retrieval and generation scored
            separately, golden datasets versioned in Langfuse, evaluation runs
            gated in CI.
          </p>
          <p class="text-body-md text-text-muted leading-relaxed">
            Because I have also shipped production code, I review developer
            written tests credibly and design harnesses that teams adopt.
          </p>
        </section>

        <section data-reveal>
          <h2 class="font-mono text-mono-xs text-primary uppercase tracking-widest mb-4">
            _COMPETENCIES
          </h2>
          <div class="flex flex-col gap-3">
            {
              competencies.map((c) => (
                <div class="p-4 border border-border-dark bg-surface-container-low">
                  <h3 class="font-mono text-mono-label text-on-surface mb-1">
                    {c.title}
                  </h3>
                  <p class="font-mono text-mono-xs text-text-muted leading-relaxed">
                    {c.items}
                  </p>
                </div>
              ))
            }
          </div>
        </section>

        <section data-reveal>
          <h2 class="font-mono text-mono-xs text-primary uppercase tracking-widest mb-3">
            _EDUCATION
          </h2>
          <p class="font-mono text-mono-label text-on-surface">
            Hyperion University of Bucharest
          </p>
          <p class="font-mono text-mono-xs text-text-muted">
            Applied Informatics and Automation · 2015 to 2019
          </p>
        </section>

        <section data-reveal>
          <h2 class="font-mono text-mono-xs text-primary uppercase tracking-widest mb-3">
            _LANGUAGES
          </h2>
          <p class="font-mono text-mono-xs text-text-muted">
            English, Full Professional · Romanian, Native
          </p>
        </section>
      </aside>

      <!-- Right: experience accordion -->
      <div class="md:col-span-8 flex flex-col gap-4">
        <h2 class="font-mono text-mono-xs text-primary uppercase tracking-widest mb-2">
          _EXPERIENCE
        </h2>
        {
          experience.map((company) => (
            <details class="accordion border border-border-dark bg-surface" open={company.open}>
              <summary class="flex justify-between items-center gap-4 p-6">
                <div class="flex flex-col md:flex-row md:items-baseline gap-1 md:gap-3">
                  <h3 class="text-headline-md text-text-primary">{company.company}</h3>
                  <span class="font-mono text-mono-xs text-text-muted">
                    {company.projects.length > 1
                      ? `${company.projects.length} projects`
                      : company.projects[0].role}
                  </span>
                </div>
                <div class="flex items-center gap-4 shrink-0">
                  <span class="font-mono text-mono-xs text-text-muted">
                    {company.period}
                  </span>
                  <Icon
                    name="material-symbols:expand-more"
                    class="acc-chevron text-primary text-[22px]"
                  />
                </div>
              </summary>
              <div class="px-6 pb-6 pt-2 border-t border-border-dark">
                {company.summary && (
                  <p class="text-body-md text-text-muted mb-6">{company.summary}</p>
                )}
                <div class="flex flex-col gap-7">
                  {company.projects.map((proj) => (
                    <div class="relative pl-5 border-l border-border-dark">
                      <span class="absolute -left-[4.5px] top-2 w-2 h-2 rounded-full bg-primary" />
                      <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-2">
                        <h4 class="font-mono text-mono-label text-on-surface">{proj.role}</h4>
                        <span class="font-mono text-mono-xs text-text-muted shrink-0">
                          {proj.period}
                        </span>
                      </div>
                      {proj.summary && (
                        <p class="text-body-md text-text-muted mb-3">{proj.summary}</p>
                      )}
                      {proj.points.length > 0 && (
                        <ul class="flex flex-col gap-2 mb-3 list-none">
                          {proj.points.map((pt) => (
                            <li class="text-body-md text-text-muted flex gap-3">
                              <span class="text-primary mt-1 shrink-0">▹</span>
                              <span>{pt}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                      {proj.tags.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                          {proj.tags.map((t) => (
                            <span class="font-mono text-mono-xs px-2 py-1 bg-background-dark border border-border-dark text-primary">
                              {t}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
