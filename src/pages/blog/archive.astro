---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { postUrl, homeUrl } from '../../lib/url'
import { BLOG_PUBLISHED, publishedPosts } from '../../lib/publishing'

// An archive of nothing is not a page: while the blog is unpublished this route
// sends readers to the coming-soon notice instead.
if (!BLOG_PUBLISHED) return Astro.redirect(homeUrl(), 301)

const posts = (await publishedPosts()).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
)

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
---

<BaseLayout title="Archive | Blog" description="Every post, newest first.">
  <main
    class="pt-32 pb-section-gap max-w-container-max mx-auto px-margin-mobile md:px-gutter"
    data-pagefind-body
  >
    <h1
      class="font-sans text-display-xl-mobile md:text-display-xl text-text-primary mb-12"
    >
      Archive
    </h1>
    <ul class="border-t border-border-dark">
      {
        posts.map((p) => (
          <li class="border-b border-border-dark">
            <a
              href={postUrl(p.id)}
              class="group flex flex-col md:flex-row md:items-baseline gap-1 md:gap-6 py-5 px-2 -mx-2 hover:bg-surface-hover transition-colors"
            >
              <time
                datetime={p.data.pubDate.toISOString()}
                class="font-mono text-mono-xs text-text-muted w-28 shrink-0"
              >
                {fmt(p.data.pubDate)}
              </time>
              <span class="font-mono text-mono-xs text-primary w-36 shrink-0 uppercase">
                {p.data.kicker}
              </span>
              <span class="text-body-md text-text-primary group-hover:text-primary transition-colors">
                {p.data.title}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
