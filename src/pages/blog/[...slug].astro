---
import { render } from 'astro:content'
import ArticleLayout from '../../layouts/ArticleLayout.astro'
import { mdxComponents } from '../../components/mdx'
import { postUrl, seriesUrl } from '../../lib/url'
import { postsInSeries, seriesRepoUrl } from '../../lib/series'
import { publishedPosts } from '../../lib/publishing'

export async function getStaticPaths() {
  // Empty while the blog is unpublished, so no post page is built.
  const posts = await publishedPosts()
  const byDate = [...posts].sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
  )

  return posts.map((post) => {
    const toCard = (p: (typeof posts)[number]) => ({
      href: postUrl(p.id),
      title: p.data.title,
      kicker: p.data.kicker,
    })

    // In-article series navigator: ordered parts + prev/next, when the post
    // belongs to a series.
    const seriesName = post.data.series?.name
    const members = seriesName ? postsInSeries(posts, seriesName) : []
    const idx = members.findIndex((p) => p.id === post.id)
    // Per-part code link: point GitHub Code at this part's frozen tag when the
    // post declares one, else fall back to the series' repo root.
    const repoBase = seriesName ? seriesRepoUrl(seriesName) : undefined
    const code = post.data.series?.code
    const repoUrl = repoBase && code ? `${repoBase}/tree/${code}` : repoBase
    const series =
      seriesName && idx !== -1
        ? {
            name: seriesName,
            href: seriesUrl(seriesName),
            repoUrl,
            current: idx + 1,
            total: members.length,
            parts: members.map((p) => ({
              href: postUrl(p.id),
              title: p.data.title,
              order: p.data.series?.order ?? 0,
              isCurrent: p.id === post.id,
            })),
            prev:
              idx > 0
                ? { href: postUrl(members[idx - 1].id), title: members[idx - 1].data.title }
                : undefined,
            next:
              idx < members.length - 1
                ? { href: postUrl(members[idx + 1].id), title: members[idx + 1].data.title }
                : undefined,
          }
        : undefined

    // Related: same-series first, then same-topic, then most recent others.
    // Dedup by id preserves that priority order without double-counting.
    const sameSeries = seriesName
      ? byDate.filter((p) => p.id !== post.id && p.data.series?.name === seriesName)
      : []
    const sameTopic = byDate.filter(
      (p) => p.id !== post.id && p.data.topic === post.data.topic,
    )
    const others = byDate.filter(
      (p) => p.id !== post.id && p.data.topic !== post.data.topic,
    )
    const seen = new Set<string>()
    const related = [...sameSeries, ...sameTopic, ...others]
      .filter((p) => (seen.has(p.id) ? false : (seen.add(p.id), true)))
      .slice(0, 2)
      .map(toCard)

    return { params: { slug: post.id }, props: { post, related, series } }
  })
}

const { post, related, series } = Astro.props
const { Content, headings, remarkPluginFrontmatter } = await render(post)
const minutesRead = remarkPluginFrontmatter.minutesRead as number | undefined
---

<ArticleLayout
  title={post.data.title}
  description={post.data.description}
  kicker={post.data.kicker}
  author={post.data.author}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  minutesRead={minutesRead}
  image={(post.data.ogImage ?? post.data.coverImage)?.src}
  cover={post.data.coverImage}
  coverAlt={post.data.coverImageAlt}
  headings={headings}
  related={related}
  topic={post.data.topic}
  series={series}
  faq={post.data.faq}
  ctaNote={post.data.ctaNote}
>
  <Content components={mdxComponents} />
</ArticleLayout>
