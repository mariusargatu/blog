{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "compatibility_date": "2026-06-01",
  // Worker script handles POST /api/event (first-party CTA analytics via
  // Analytics Engine); everything else falls through to the static assets.
  // Asset-matching requests are still served directly without invoking the
  // Worker. No SSR, no prerender server. `_redirects` and `_headers` inside
  // dist/ are honored, same as Cloudflare Pages.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "analytics_engine_datasets": [
    {
      "binding": "CTA_EVENTS",
      "dataset": "blog_cta_events"
    }
  ]
}
